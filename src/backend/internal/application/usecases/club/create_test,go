type clubHarness struct {
	clubs      *mocks.ClubRepository
	players    *mocks.PlayerRepository
	badges     *mocks.BadgeRepository
	clubBadges *mocks.ClubBadgeRepository
	clock      *mocks.Clock
	tx         *mocks.TransactionManager
	now        time.Time
	founding   dombadge.Badge
}

func newClubHarness(t *testing.T, now time.Time) *clubHarness {
	h := &clubHarness{
		clubs:      mocks.NewClubRepository(t),
		players:    mocks.NewPlayerRepository(t),
		badges:     mocks.NewBadgeRepository(t),
		clubBadges: mocks.NewClubBadgeRepository(t),
		clock:      mocks.NewClock(t),
		tx:         mocks.NewTransactionManager(t),
		now:        now,
	}
	h.founding = dombadge.Badge{
		ID:          shared.NewBadgeID(),
		Code:        club.BadgeCodeFounding,
		Icon:        "🏛️",
		Name:        "Основание",
		Description: "Клуб создан",
		Type:        dombadge.TypeClub,
		Rarity:      dombadge.RarityCommon,
		CreatedAt:   now,
	}
	return h
}

func (h *clubHarness) build(t *testing.T) *club.CreateClub {
	t.Helper()
	uc, err := club.NewCreateClub(club.CreateClubDeps{
		Clubs:     h.clubs,
		Players:   h.players,
		Badges:    h.badges,
		ClubBadge: h.clubBadges,
		Clock:     h.clock,
		Tx:        h.tx,
	})
	require.NoError(t, err)
	return uc
}

func (h *clubHarness) expectTx() {
	h.tx.EXPECT().WithinTransaction(mock.Anything, mock.Anything).
		RunAndReturn(func(ctx context.Context, fn func(context.Context) error) error {
			return fn(ctx)
		}).Maybe()
}

func makePlayer(t *testing.T, now time.Time, status domplayer.Status) *domplayer.Player {
	t.Helper()
	p, err := domplayer.New(domplayer.NewPlayerParams{
		FullName:     "Alice",
		Email:        "alice@example.com",
		PasswordHash: "hashed:x",
		Nickname:     "alice",
		City:         "Moscow",
	}, now)
	require.NoError(t, err)
	p.Status = status
	return p
}

func TestCreateClub(t *testing.T) {
	t.Parallel()

	now := time.Date(2025, 1, 1, 12, 0, 0, 0, time.UTC)

	tests := []struct {
		name          string
		creatorStatus domplayer.Status
		clubName      string
		existingName  string
		wantErr       error
		wantBadge     bool
	}{
		{
			name:          "успех + бейдж «Основание»",
			creatorStatus: domplayer.StatusActive,
			clubName:      "Shibuya",
			wantBadge:     true,
		},
		{
			name:          "пустое имя",
			creatorStatus: domplayer.StatusActive,
			clubName:      "",
			wantErr:       shared.ErrValidation,
		},
		{
			name:          "имя занято",
			creatorStatus: domplayer.StatusActive,
			clubName:      "Shibuya",
			existingName:  "Shibuya",
			wantErr:       shared.ErrAlreadyExists,
		},
		{
			name:          "забаненный не может создать",
			creatorStatus: domplayer.StatusBanned,
			clubName:      "Kyoto",
			wantErr:       shared.ErrForbidden,
		},
	}

	for _, tt := range tests {
		tt := tt
		t.Run(tt.name, func(t *testing.T) {
			t.Parallel()

			h := newClubHarness(t, now)
			h.clock.EXPECT().Now().Return(now).Maybe()

			creator := makePlayer(t, now, tt.creatorStatus)

			// Создателя читаем только если имя непустое
			// (иначе падаем раньше).
			if tt.clubName != "" {
				h.players.EXPECT().GetByID(mock.Anything, creator.ID).
					Return(creator, nil).Once()
			}

			if tt.clubName != "" {
				exists := tt.existingName != ""
				h.clubs.EXPECT().ExistsByName(mock.Anything, tt.clubName).
					Return(exists, nil).Once()
			}

			if tt.wantErr == nil {
				// Бейдж «Основание» — не критичен, поэтому Maybe().
				h.badges.EXPECT().GetByCode(mock.Anything, club.BadgeCodeFounding).
					Return(&h.founding, nil).Maybe()

				h.clubs.EXPECT().
					Create(mock.Anything, mock.AnythingOfType("*club.Club")).
					Return(nil).Once()
				h.players.EXPECT().
					Update(mock.Anything, mock.AnythingOfType("*player.Player")).
					Return(nil).Once()

				if tt.wantBadge {
					h.clubBadges.EXPECT().
						Create(mock.Anything, mock.AnythingOfType("*badge.ClubBadge")).
						Return(nil).Once()
				}
				h.expectTx()
			}

			uc := h.build(t)
			got, err := uc.Execute(context.Background(), dto.CreateClubInput{
				Name:      tt.clubName,
				City:      "Tokyo",
				CreatorID: creator.ID,
			})

			if tt.wantErr != nil {
				require.Error(t, err)
				require.True(t, errors.Is(err, tt.wantErr),
					"expected %v, got %v", tt.wantErr, err)
				return
			}
			require.NoError(t, err)
			require.NotNil(t, got)
			require.NotNil(t, got.Club)
			require.Equal(t, tt.clubName, got.Club.Name)
		})
	}
}